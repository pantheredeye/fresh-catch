SESSION_SECRET=your-development-secret-key

# Comma-separated allowlist — these emails get isAdmin on login (see #55).
ADMIN_EMAILS=you@example.com

# Optional: email sending (Resend). Without it, email sends are skipped with a log line.
RESEND_API_KEY=your-resend-api-key

# Optional: Stripe payments (#60). Without STRIPE_SECRET_KEY the "Request
# payment" action is hidden and orders settle in person only.
# Direct charges on Evan's connected account — he is merchant of record; the
# platform only collects an application fee (Vendor.platformFeeBps).
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-connect-endpoint-secret
STRIPE_CONNECT_ACCOUNT_ID=acct_your-connected-account
