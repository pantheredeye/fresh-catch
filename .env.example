WEBAUTHN_RP_ID=localhost
AUTH_SECRET_KEY=your-development-secret-key

# Required for Stripe Connect onboarding, checkout, and webhook verification.
# Without these the app boots, but payment code paths fail loudly (see
# src/utils/env.ts) instead of 500ing silently.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Optional: email sending (Resend). Without it, email sends are skipped with a log line.
RESEND_API_KEY=your-resend-api-key

# Optional: Enable Turnstile bot protection
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA