// Single-vendor schema for v2 (spec #50 §4 / issue #53). No data migrates
// from the old multi-tenant prod DB yet (cutover is a later bead) — see
// docs/audit/data-stripe.md §1a and REBUILD-PLAN.md §4 for the do-not-migrate
// list (8 dead Organization rows, stray "Test popup" market).

generator client {
  provider = "prisma-client"

  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"

  output = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                       String  @id @default(uuid())
  name                     String
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  platformFeeBps           Int     @default(500)
  notificationEmail        String?
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique // OTP login upserts on this; SQLite allows multiple NULLs
  name      String?
  phone     String?
  isAdmin   Boolean  @default(false) // replaces org/role/membership entirely
  createdAt DateTime @default(now())

  orders   Order[]
  requests FishRequest[]
}

model Market {
  id              String   @id @default(uuid())
  name            String
  schedule        String // Free-form schedule description (e.g., "Sat 8-2")
  subtitle        String?
  locationDetails String? // Vendor-facing: booth location, setup notes, parking info
  customerInfo    String? // Customer-facing: payment methods, what to bring, best times
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Popup market fields
  type          String    @default("regular") // "regular" | "popup"
  expiresAt     DateTime?
  catchPreview  String? // JSON: { items: [{name, note}] }
  notes         String?
  rawTranscript String? // Verbatim Whisper output (null for form-created)
  cancelledAt   DateTime?

  county String?
  city   String?

  @@index([active])
  @@index([type, active])
}

model CatchUpdate {
  id               String   @id @default(uuid())
  recordedBy       String?
  rawTranscript    String
  formattedContent String // JSON: { headline, items[], summary }
  status           String   @default("live") // "live" | "archived"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

// Request-anchored threads replace general-purpose chat for v1 (issue #50
// comment, issue #59). Structured starter (species/notes/contact) creates a
// FishRequest; the conversation that closes the loop lives in RequestMessage.
model FishRequest {
  id            String    @id @default(uuid())
  userId        String?
  contactName   String
  contactEmail  String?
  contactPhone  String?
  species       String
  notes         String?
  status        String    @default("open") // open | fulfilled | declined
  evanResponse  String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  user     User?            @relation(fields: [userId], references: [id])
  messages RequestMessage[]

  @@index([status])
  @@index([createdAt])
}

model RequestMessage {
  id        String   @id @default(uuid())
  requestId String
  sender    String // "customer" | "vendor"
  body      String
  createdAt DateTime @default(now())

  request FishRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}

/// Dormant until the payments phase — carried over from the old schema minus
/// organizationId (single vendor now); see docs/audit/data-stripe.md §3.
model Order {
  id          String    @id @default(uuid())
  orderNumber Int       @unique
  userId      String?

  contactName  String
  contactEmail String?
  contactPhone String?

  items         String
  preferredDate DateTime?
  notes         String?

  status     String  @default("pending") // pending | confirmed | completed | cancelled
  price      Int?
  adminNotes String?

  tipAmount      Int  @default(0)
  platformFeeBps Int?
  platformFee    Int?
  totalDue       Int?
  amountPaid     Int  @default(0)
  depositAmount  Int?

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  paymentMethod String?
  paymentNotes  String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  amount          Int
  method          String // stripe | cash | venmo | zelle | other
  type            String // deposit | payment | tip | refund
  stripePaymentId String?
  notes           String?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// Email-keyed login codes (OTP). Keyed by SHA-256 of normalized email so
// verification works regardless of which browser/cookie context submits it.
model LoginCode {
  emailHash String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Fixed-window rate limit counters (see docs/audit — v2 has no Durable
// Objects, so this replaces the old RateLimitDurableObject). `id` is the
// bucket key, e.g. "id:<sha256(email)>:otpSend" or "ip:<ip>:otpSendIp".
// One row per key, overwritten each window — no unbounded growth, no sweep.
model RateLimitBucket {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime
}
