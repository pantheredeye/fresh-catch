{
  "name": "fresh-catch",
  "version": "1.0.0",
  "description": "Fresh Catch — Hono on Cloudflare Workers.",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run migrate:prd && npm run build && wrangler deploy",
    "generate": "prisma generate && wrangler types",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:dev": "prisma generate && wrangler d1 migrations apply DB --local",
    "migrate:prd": "wrangler d1 migrations apply DB --remote",
    "seed": "wrangler d1 execute DB --local --file=./prisma/seed.sql"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "hono": "^4.6.0",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^22.14.0",
    "prisma": "6.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^4.1.2",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
